# Methodly MVP - Environment Variables
# Automation layer: Netlify Functions (NO Zapier / Make / n8n)
# Set real values in Netlify > Site settings > Environment variables.
# Never commit real secrets to git.

# Twilio (phone calls + SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# HubSpot (CRM) - Private App token
HUBSPOT_PRIVATE_APP_TOKEN=

# Resend (transactional email)
RESEND_API_KEY=

# Methodly config (non-secret)
METHODLY_BOOKING_URL=https://meetings.hubspot.com/methodly
METHODLY_FROM_EMAIL=results@methodly.me
METHODLY_SUPPORT_EMAIL=results@methodly.me
